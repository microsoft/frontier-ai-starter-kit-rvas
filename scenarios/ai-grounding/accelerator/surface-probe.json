{
  "description": "Example surface verification plan. Replace the request and response markers with values that match your deployed surface and approved test corpus.",
  "request": {
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "input": "What discretionary goodwill credit can a supervisor approve?"
    }
  },
  "callers": {
    "anonymous": {
      "expected_statuses": [
        401,
        403
      ]
    },
    "authorized": {
      "expected_statuses": [
        200
      ],
      "response_must_contain": [
        "goodwill credit ceiling"
      ]
    },
    "restricted": {
      "expected_statuses": [
        200,
        403
      ],
      "response_must_not_contain": [
        "goodwill credit ceiling",
        "returns-supervisor-playbook"
      ]
    }
  }
}
