{
  "name": "frontier-ai-starter-kit-rvas",
  "version": "1.0.0",
  "description": "Microsoft Foundry session static site builder",
  "scripts": {
    "audit:docs": "node scripts/audit-docs.js",
    "audit:docs:source": "node scripts/audit-docs.js --source",
    "audit:docs:generated": "node scripts/audit-docs.js --generated",
    "validate:diagrams": "python3 scripts/audit-diagrams.py",
    "validate:scenarios": "python3 scripts/validate-scenarios.py && npm run validate:diagrams",
    "build": "npm run audit:docs:source && node docs/build.js && npm run audit:docs:generated"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
