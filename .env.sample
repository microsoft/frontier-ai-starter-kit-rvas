# ============================================================================
# AI Starter Kit — .env CONTRACT (sample)
#
# DO NOT COMMIT a real .env. This file documents the variable names only.
#
# Golden path:  `azd up`  then  `azd env get-values > .env`
# Fallback:     `./scripts/deploy.sh`  (writes .env directly)
#
# Core variable names are emitted by infra/main.bicep outputs and consumed by
# scripts/setup-foundations.sh, scripts/validate-foundations.py, and the activities.
# Specialist-service variables are optional and supplied by the resource owner when that
# canonical session is selected.
# ============================================================================

# --- Azure context ----------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=swedencentral
AZURE_ENV_NAME=rvas-foundry
# Object id of the signed-in user/SP for keyless data-plane RBAC (optional in CI).
AZURE_PRINCIPAL_ID=

# --- Microsoft Foundry ------------------------------------------------------
# Account-level endpoint (also used as the OpenAI-compatible endpoint).
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
# Project endpoint — pass to AIProjectClient(endpoint=...).
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_PROJECT_NAME=
# Model deployment (alias) name + catalog model name. The SDK selects its API version.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o
AZURE_AI_MODEL_NAME=gpt-4o

# --- Azure AI Search (knowledge base) ---------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=university-faq
# Foundry project connection name pointing at the Search service.
AZURE_SEARCH_CONNECTION_NAME=search
# Name of the agent built by setup-foundations.sh (Foundations end-state).
AZURE_FOUNDRY_AGENT_NAME=northfield-iq-assistant

# --- Optional specialist services -------------------------------------------
# Provision these only when completing the corresponding canonical session.
# Keep keyless auth with DefaultAzureCredential; no API keys belong in .env.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_VISION_ENDPOINT=
# Connection/tool name supplied by the data platform owner for Governed Data Copilot.
DATA_COPILOT_CONNECTION_NAME=

# --- Observability / tracing ------------------------------------------------
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
# Set before calling AIProjectInstrumentor().instrument() when client-side tracing is needed.
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true

# --- Azure Container Registry (hosted agents) -------------------------------
AZURE_CONTAINER_REGISTRY_ENDPOINT=
AZURE_CONTAINER_REGISTRY_NAME=

# ============================================================================
# Action Tools activity — AUTHORITATIVE env contract.
# These names are matched by the Action Tools backend (scripts/action-backend/),
# the FastMCP server, and the activity/eval content. If you change one, change all.
# ============================================================================
# Base URL of the REST backend (create IT ticket / course hold / advising slot).
ACTION_API_URL=http://localhost:8080
# MCP server endpoint the agent attaches as an McpTool (streamable-http).
ACTION_MCP_URL=http://localhost:8765/mcp
# Optional shared secret sent as the `x-api-key` header to the backend + MCP server.
# Leave blank to run the backend in open (no-auth) mode for local workshops.
ACTION_API_KEY=
