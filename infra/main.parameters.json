{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=swedencentral}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "chatModelName": {
      "value": "${AZURE_AI_MODEL_NAME=gpt-4o}"
    },
    "chatModelVersion": {
      "value": "${AZURE_AI_MODEL_VERSION=2024-11-20}"
    },
    "chatModelDeploymentName": {
      "value": "${AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o}"
    },
    "chatModelSkuName": {
      "value": "${AZURE_AI_MODEL_SKU=GlobalStandard}"
    },
    "chatModelCapacity": {
      "value": "${AZURE_AI_MODEL_CAPACITY=30}"
    }
  }
}
